# Environment: development (local) | production (cloud/Fly)
# Local: set to development for CORS defaults (localhost:8000, localhost:5713).
# Cloud: set in fly.toml / secrets; Fly is auto-detected as production.
PHILOSOPH_ENV=development
PHILOSOPH_LOG_LEVEL=DEBUG
PHILOSOPH_SCOPE_LOG_LEVEL=DEBUG
PHILOSOPH_TRACE_LOG_LEVEL=DEBUG
PHILOSOPH_TRACE_VERBOSE=1
PHILOSOPH_TRACE_TRAVERSAL=1
PHILOSOPH_TRACE_MAX_ITEMS=20
PHILOSOPH_TRACE_MAX_STEPS=200

PHILOSOPH_ENV=development
PHILOSOPH_MAX_TRAVERSAL_NODES=8

PHILOSOPH_RATE_LIMIT_REQUESTS=4
PHILOSOPH_RATE_LIMIT_WINDOW_SECONDS=60


# Database
PHILOSOPH_DB=/path/to/duckdb-file

# LLM / Embeddings (REQUIRED)
OPENAI_API_KEY=sk-...your-key-here

# CORS (optional): comma-separated origins. In development, defaults to localhost:8000, localhost:5713.
# In production, defaults to host domain. Override here to add more origins.
CORS_ORIGINS=https://host-domain.xyz,https://www.host-domain.xyz

# Agent: max nodes in traversal path before forcing synthesis (4–24, default 8)
# PHILOSOPH_MAX_TRAVERSAL_NODES=5

# Server
PORT=8000