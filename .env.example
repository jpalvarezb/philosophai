# Environment: development (local) | production (cloud/Fly)
# Local: set to development for CORS defaults (localhost:8000, localhost:5713).
# Cloud: set in fly.toml / secrets; Fly is auto-detected as production.
PHILOSOPH_ENV=development

# Database
PHILOSOPH_DB=./data/philosoph.duckdb

# LLM / Embeddings (REQUIRED)
OPENAI_API_KEY=sk-...your-key-here

# CORS (optional): comma-separated origins. In development, defaults to localhost:8000, localhost:5713.
# In production, defaults to butlerian.xyz. Override here to add more origins.
# CORS_ORIGINS=https://butlerian.xyz,https://www.butlerian.xyz

# Agent: max nodes in traversal path before forcing synthesis (4–24, default 8)
# PHILOSOPH_MAX_TRAVERSAL_NODES=5

# Server
PORT=8000
LOG_LEVEL=INFO
